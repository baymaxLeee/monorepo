{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices"],
  "dependencyDashboard": true,
  "packageRules": [
    {
      "groupName": "pnpm toolchain",
      "matchManagers": ["npm", "mise", "github-actions"],
      "matchPackageNames": ["pnpm", "pnpm/action-setup"]
    },
    {
      "groupName": "React Module Federation runtime",
      "matchManagers": ["npm"],
      "matchPackageNames": [
        "react",
        "react-dom",
        "react-router-dom",
        "zustand",
        "@module-federation/enhanced",
        "@rspack/core",
        "@rspack/cli",
        "@rspack/dev-server"
      ]
    },
    {
      "groupName": "Vercel AI SDK",
      "matchManagers": ["npm"],
      "matchPackageNames": ["/^ai$/", "/^@ai-sdk\\//"]
    },
    {
      "groupName": "OpenTelemetry Go",
      "matchManagers": ["gomod"],
      "matchPackageNames": ["/^go\\.opentelemetry\\.io\\//"]
    },
    {
      "groupName": "OpenTelemetry Python",
      "matchManagers": ["uv"],
      "matchPackageNames": ["/^opentelemetry-/"]
    }
  ]
}
