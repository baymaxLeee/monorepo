{
  "name": "@backend/inner-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./*": "./src/*.ts"
  },
  "scripts": {
    "build": "node node_modules/@typescript/native/bin/tsc -p tsconfig.json --noEmit",
    "lint": "pnpm --dir ../../../.. lint:ts apps/backend/libs/inner-api-ts && pnpm --dir ../../../.. exec oxfmt --check 'apps/backend/libs/inner-api-ts/**/*.{ts,json}' && node node_modules/@typescript/native/bin/tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test",
    "typecheck": "node node_modules/@typescript/native/bin/tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.11.0",
    "@grpc/grpc-js": "^1.14.3",
    "long": "^5.3.2",
    "protobufjs": "^7.5.4"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@typescript/native": "catalog:",
    "tsx": "^4.19.0"
  }
}
