{
  "name": "@backend/transport-ts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "codegen": "openapi-typescript ../../../../schemas/openapi/admin-server.json -o src/schema/admin.ts && openapi-typescript ../../../../schemas/openapi/knowledge-server.json -o src/schema/knowledge.ts && openapi-typescript ../../../../schemas/openapi/executor-server.json -o src/schema/executor.ts",
    "typecheck": "node node_modules/@typescript/native/bin/tsc -p tsconfig.json --noEmit"
  },
  "exports": {
    ".": "./src/index.ts",
    "./admin": "./src/admin.ts",
    "./executor": "./src/executor.ts",
    "./knowledge": "./src/knowledge.ts",
    "./provider-model": "./src/provider-model.ts",
    "./provider-url": "./src/provider-url.ts"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "catalog:",
    "@ai-sdk/provider": "catalog:",
    "openapi-fetch": "^0.17.0"
  },
  "devDependencies": {
    "@typescript/native": "catalog:",
    "@types/node": "^22.13.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.8.0"
  }
}
