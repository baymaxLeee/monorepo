set positional-arguments
set shell := ["bash", "-cu"]

# Service registry (Python / Node / Go services and their fixed dev ports)
PY_SERVICES := "knowledge"
NODE_SERVICES := "runtime"
GO_SERVICES := "gateway iam admin canvas chat storage telemetry"
OPENAPI_SERVICES := "admin knowledge chat iam canvas storage telemetry"
SQLC_SERVICES := "admin canvas chat iam storage telemetry"
SQLC_VERSION := "v1.31.1"
OAPI_CODEGEN_VERSION := "v2.8.2"

# Fixed port allocation so multiple agents/dev servers don't collide
PORTS := '{"gateway":8000,"admin":8001,"iam":8002,"telemetry":8008,"chat":8009,"knowledge":8010,"canvas":8012,"storage":8013,"runtime":8015}'

default:
    @just --list

# ─── dev ────────────────────────────────────────────────
dev service:
    @PORT=$(echo '{{ PORTS }}' | jq -r '.["{{ service }}"]') && \
    if [ -d "services/{{ service }}" ]; then \
        if [ -f "services/{{ service }}/go.mod" ]; then \
            echo "→ Go service {{ service }} on :$PORT" && \
            cd services/{{ service }} && PORT=$PORT go run ./cmd/server; \
        elif [ -f "services/{{ service }}/package.json" ]; then \
            echo "→ Node service {{ service }} on :$PORT" && \
            cd services/{{ service }} && PORT=$PORT pnpm dev; \
        else \
            echo "→ Python service {{ service }} on :$PORT" && \
            cd services/{{ service }} && uv run uvicorn main:app --app-dir src --reload --port $PORT --no-access-log; \
        fi; \
    else echo "✗ Unknown service: {{ service }}"; exit 1; fi

# ─── build ──────────────────────────────────────────────
# Python services don't need a separate build step — they ship as source +
# uv lock. For Go services we produce a static binary; for either, we can
# also build a container image via `build-image`.
#
#   just build                       # everything: Go binaries + every image
#   just build gateway           # single Go service binary
#   just build admin                 # Go service binary
#   just build-image admin           # docker build for a single service
#   just build-images                # docker build for ALL services
#
# Image tags default to local/<svc>:latest. Override with positional args.
build target="":
    @if [ -z "{{ target }}" ]; then \
        just build-go && just build-node && just build-images; \
    elif [ -d "services/{{ target }}" ]; then \
        if [ -f "services/{{ target }}/go.mod" ]; then just build-go-svc {{ target }}; \
        elif [ -f "services/{{ target }}/package.json" ]; then just build-node-svc {{ target }}; \
        else just build-py-svc {{ target }}; fi; \
    else echo "✗ Unknown service: {{ target }}"; exit 1; fi

# Build all Go services to native binaries (services/<svc>/bin/server)
build-go:
    @for s in {{ GO_SERVICES }}; do just build-go-svc $s; done
    @echo "✓ Go binaries → services/<svc>/bin/server"

# Build and typecheck all Node services from the root workspace.
build-node:
    pnpm --dir ../.. install --frozen-lockfile
    @for s in {{ NODE_SERVICES }}; do \
        pnpm --filter ./services/$s run --if-present typecheck && pnpm --filter ./services/$s run build || exit 1; \
    done

build-go-svc service:
    @echo "→ Building Go service: {{ service }}"
    cd services/{{ service }} && mkdir -p bin && \
        CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o bin/server ./cmd/server
    @ls -lh services/{{ service }}/bin/server | awk '{print "  size:", $5}'

# "Build" a Python service = lint + test + OpenAPI export (release pre-flight).
# No bytecode artifact — uvicorn runs from source.
build-py-svc service:
    @echo "→ Pre-flighting Python service: {{ service }}"
    cd services/{{ service }} && uv run ruff check .
    cd services/{{ service }} && uv run ruff format --check .
    just gen-openapi {{ service }}
    @echo "✓ {{ service }} ready (run as image via: just build-image {{ service }})"

# "Build" a Node service = typecheck + OpenAPI export.
build-node-svc service:
    @echo "→ Pre-flighting Node service: {{ service }}"
    pnpm --dir ../.. install --frozen-lockfile
    pnpm --filter ./services/{{ service }} run --if-present typecheck
    pnpm --filter ./services/{{ service }} run build
    pnpm --filter ./services/{{ service }} run gen-openapi
    @echo "✓ {{ service }} ready (run as image via: just build-image {{ service }})"

# Build a single service's docker image. Usage:
#   just build-image admin
# just build-image gateway my-registry.io v1.2.3
build-image service registry="local" tag="latest":
    @if [ ! -f "services/{{ service }}/Dockerfile" ]; then \
        echo "✗ services/{{ service }}/Dockerfile not found"; exit 1; fi
    @echo "→ docker build {{ registry }}/{{ service }}:{{ tag }}"
    @if echo "{{ PY_SERVICES }}" | tr ' ' '\n' | grep -qx "{{ service }}"; then \
        docker build -t {{ registry }}/{{ service }}:{{ tag }} -f services/{{ service }}/Dockerfile .; \
    elif echo "{{ NODE_SERVICES }}" | tr ' ' '\n' | grep -qx "{{ service }}"; then \
        docker build -t {{ registry }}/{{ service }}:{{ tag }} -f services/{{ service }}/Dockerfile ../..; \
    else \
        docker build -t {{ registry }}/{{ service }}:{{ tag }} -f services/{{ service }}/Dockerfile .; \
    fi
    @echo "✓ {{ registry }}/{{ service }}:{{ tag }}"

# Build images for all services and the sandbox guest/proxy assets.
build-images registry="local" tag="latest":
    @for s in {{ PY_SERVICES }} {{ NODE_SERVICES }} {{ GO_SERVICES }}; do \
        just build-image $s {{ registry }} {{ tag }} || exit 1; \
    done
    cd ../.. && just build-sandbox-runtime {{ registry }} {{ tag }}
    cd ../.. && just build-sandbox-proxy {{ registry }} {{ tag }}
    @echo "✓ All backend images built with tag {{ registry }}/<svc>:{{ tag }}"

# ─── quality ────────────────────────────────────────────
test target="" *args:
    @node ../../scripts/test.mjs "backend/$1" "${@:2}"

fmt:
    pnpm --dir ../.. exec oxfmt --write 'apps/backend/**/*.{js,mjs,cjs,jsx,ts,tsx,mts,cts,json,jsonc}'
    uv run ruff check --fix .
    uv run ruff format .
    @just fmt-go

fmt-go:
    @for s in {{ GO_SERVICES }}; do cd services/$s && gofmt -w .; cd ../..; done

lint scope="":
    @if [ -z "{{ scope }}" ]; then \
        uv run ruff check . && \
        uv run ruff format --check . && \
        just typecheck-python && \
        just lint-node && just lint-go; \
    elif [ -f "services/{{ scope }}/go.mod" ]; then \
        cd services/{{ scope }} && go vet ./...; \
    elif [ -f "services/{{ scope }}/package.json" ]; then \
        cd services/{{ scope }} && pnpm run lint; \
    else \
        cd services/{{ scope }} && uv run ruff check . && uv run ruff format --check . && uv run mypy .; \
    fi

lint-node:
    pnpm --dir ../.. lint:ts apps/backend
    pnpm --dir ../.. exec oxfmt --check 'apps/backend/**/*.{js,mjs,cjs,jsx,ts,tsx,mts,cts,json,jsonc}'
    @just typecheck-node

typecheck-node:
    @for p in ../../packages/agent-runtime; do echo "=== $p ===" && (cd $p && pnpm run typecheck) || exit 1; done
    @for s in {{ NODE_SERVICES }}; do echo "=== $s ===" && (cd services/$s && pnpm run typecheck) || exit 1; done

typecheck-python:
    uv run mypy libs
    @for s in {{ PY_SERVICES }}; do (cd services/$s && uv run mypy .) || exit 1; done

lint-go:
    @for s in {{ GO_SERVICES }}; do echo "=== $s ===" && (cd services/$s && go vet ./...) || exit 1; done

# ─── schema ─────────────────────────────────────────────
gen-openapi service:
    #!/usr/bin/env bash
    set -euo pipefail
    echo "→ Exporting OpenAPI for {{ service }}..."
    out="{{ service }}-server"
    read -r runtime expected_version < <(uv run python -c 'import pathlib, sys, yaml; config=yaml.safe_load(pathlib.Path("../../services.yaml").read_text())["services"][sys.argv[1]]; print(config["runtime"], config["openapiVersion"])' "{{ service }}")
    tmpdir="$(mktemp -d)"
    trap 'rm -rf "$tmpdir"' EXIT
    if [ "{{ service }}" = "runtime" ]; then
        cd services/runtime
        pnpm exec tsx src/cmd/server/openapi.ts > "$tmpdir/runtime-server.json"
        pnpm exec tsx src/cmd/worker/openapi.ts > "$tmpdir/runtime-worker.json"
        pnpm exec tsx src/cmd/sandbox/openapi.ts > "$tmpdir/runtime-sandbox.json"
        cd ../..
    elif [ "{{ service }}" = "admin" ]; then
        just gen-admin-server
        (cd services/admin && GOWORK=off go run ./cmd/openapi) > "$tmpdir/$out.json"
    elif [ "$runtime" = "go" ]; then
        test -f "services/{{ service }}/cmd/openapi/main.go" || { echo "✗ Go service {{ service }} has no cmd/openapi exporter"; exit 1; }
        (cd services/{{ service }} && GOWORK=off go run ./cmd/openapi) > "$tmpdir/$out.json"
    elif [ "$runtime" = "node" ]; then
        (cd services/{{ service }} && pnpm exec tsx src/gen-openapi.ts) > "$tmpdir/$out.json"
    elif [ "$runtime" = "python" ]; then
        (cd services/{{ service }} && uv run python src/gen_openapi.py) > "$tmpdir/$out.json"
    else
        echo "✗ Unsupported runtime '$runtime' for {{ service }}"
        exit 1
    fi
    for artifact in "$tmpdir"/*.json; do
        node -e 'const fs=require("node:fs"); const document=JSON.parse(fs.readFileSync(process.argv[1], "utf8")); if (typeof document.openapi !== "string") process.exit(1)' "$artifact"
    done
    primary="$tmpdir/$out.json"
    test -f "$primary" || { echo "✗ {{ service }} did not export $out.json"; exit 1; }
    actual=$(node -e 'const fs=require("node:fs"); console.log(JSON.parse(fs.readFileSync(process.argv[1], "utf8")).openapi)' "$primary")
    test "$actual" = "$expected_version" || { echo "✗ {{ service }} exported OpenAPI $actual; expected $expected_version"; exit 1; }
    for artifact in "$tmpdir"/*.json; do
        mv "$artifact" "../../schemas/openapi/$(basename "$artifact")"
    done
    if [ "{{ service }}" = "runtime" ]; then
        pnpm --dir ../.. exec openapi-typescript schemas/openapi/runtime-worker.json --output apps/backend/services/runtime/src/infrastructure/transport/schema/runtime-worker.ts
        pnpm --dir ../.. exec openapi-typescript schemas/openapi/runtime-sandbox.json --output apps/backend/services/runtime/src/infrastructure/transport/schema/runtime-sandbox.ts
        pnpm --dir ../.. exec oxfmt --write apps/backend/services/runtime/src/infrastructure/transport/schema/runtime-worker.ts apps/backend/services/runtime/src/infrastructure/transport/schema/runtime-sandbox.ts
    fi
    echo "✓ schemas/openapi/$out.json ($expected_version)"

gen-openapi-all:
    @just gen-openapi runtime
    @for s in {{ OPENAPI_SERVICES }}; do just gen-openapi $s || exit 1; done

gen-sql service:
    @test -f "services/{{ service }}/sqlc.yaml" || (echo "✗ services/{{ service }}/sqlc.yaml not found" && exit 1)
    cd services/{{ service }} && GOWORK=off go run github.com/sqlc-dev/sqlc/cmd/sqlc@{{ SQLC_VERSION }} generate

gen-sql-all:
    @for s in {{ SQLC_SERVICES }}; do just gen-sql $s || exit 1; done

gen-admin-server:
    #!/usr/bin/env bash
    set -euo pipefail
    tmpdir="$(mktemp -d)"
    trap 'rm -rf "$tmpdir"' EXIT
    node ../../schemas/codegen/prepare-admin-server.mjs --target admin-server --output "$tmpdir/admin.json"
    GOWORK=off go run github.com/oapi-codegen/oapi-codegen/v2/cmd/oapi-codegen@{{ OAPI_CODEGEN_VERSION }} -generate types,gin-server,spec,skip-prune -package adminapi -o services/admin/internal/api/generated/adminapi/server.gen.go "$tmpdir/admin.json"
    echo "✓ Admin Go server bindings regenerated"

gen-transport-all: gen-proto

gen-proto:
    cd ../../schemas/proto && buf generate
    pnpm --dir ../.. exec oxfmt --write 'apps/backend/libs/inner-api-ts/src/gen/**/*.ts'
    @echo "✓ proto codegen done"

# ─── db ─────────────────────────────────────────────────
migrate-up service target="":
    @cd ../.. && just migrate-up "{{ service }}" "{{ target }}"

# Explicit schema downgrade; refuses missing or unsafe reverse migrations.
migrate-down service target:
    @cd ../.. && just migrate-down "{{ service }}" "{{ target }}"
