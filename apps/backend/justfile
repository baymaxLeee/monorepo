set positional-arguments
set shell := ["bash", "-cu"]

# Service registry (Python / Node / Go services and their fixed dev ports)
PY_SERVICES := "admin knowledge telemetry"
NODE_SERVICES := "chat executor"
GO_SERVICES := "gateway iam"

# Fixed port allocation so multiple agents/dev servers don't collide
PORTS := '{"admin":8001,"iam":8002,"permission":8005,"audit":8006,"notification":8007,"telemetry":8008,"chat":8009,"knowledge":8010,"gateway":8000,"executor":8011}'

default:
    @just --list

# ─── dev ────────────────────────────────────────────────
dev service:
    @PORT=$(echo '{{ PORTS }}' | jq -r '.["{{ service }}"]') && \
    if [ -d "services/{{ service }}" ]; then \
        if [ -f "services/{{ service }}/go.mod" ]; then \
            echo "→ Go service {{ service }} on :$PORT" && \
            cd services/{{ service }} && PORT=$PORT go run ./cmd/server; \
        elif [ -f "services/{{ service }}/package.json" ]; then \
            echo "→ Node service {{ service }} on :$PORT" && \
            cd services/{{ service }} && PORT=$PORT pnpm dev; \
        else \
            echo "→ Python service {{ service }} on :$PORT" && \
            cd services/{{ service }} && uv run uvicorn main:app --app-dir src --reload --port $PORT --no-access-log; \
        fi; \
    else echo "✗ Unknown service: {{ service }}"; exit 1; fi

# ─── build ──────────────────────────────────────────────
# Python services don't need a separate build step — they ship as source +
# uv lock. For Go services we produce a static binary; for either, we can
# also build a container image via `build-image`.
#
#   just build                       # everything: Go binaries + every image
#   just build gateway           # single Go service binary
#   just build bot                   # Python "build": pre-flight (lint + test + OpenAPI export)
#   just build-image bot             # docker build for a single service
#   just build-images                # docker build for ALL services
#
# Image tags default to local/<svc>:latest. Override with positional args.
build target="":
    @if [ -z "{{ target }}" ]; then \
        just build-go && just build-images; \
    elif [ -d "services/{{ target }}" ]; then \
        if [ -f "services/{{ target }}/go.mod" ]; then just build-go-svc {{ target }}; \
        elif [ -f "services/{{ target }}/package.json" ]; then just build-node-svc {{ target }}; \
        else just build-py-svc {{ target }}; fi; \
    else echo "✗ Unknown service: {{ target }}"; exit 1; fi

# Build all Go services to native binaries (services/<svc>/bin/server)
build-go:
    @for s in {{ GO_SERVICES }}; do just build-go-svc $s; done
    @echo "✓ Go binaries → services/<svc>/bin/server"

build-go-svc service:
    @echo "→ Building Go service: {{ service }}"
    cd services/{{ service }} && mkdir -p bin && \
        CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o bin/server ./cmd/server
    @ls -lh services/{{ service }}/bin/server | awk '{print "  size:", $5}'

# "Build" a Python service = lint + test + OpenAPI export (release pre-flight).
# No bytecode artifact — uvicorn runs from source.
build-py-svc service:
    @echo "→ Pre-flighting Python service: {{ service }}"
    cd services/{{ service }} && uv run ruff check .
    just gen-openapi {{ service }}
    @echo "✓ {{ service }} ready (run as image via: just build-image {{ service }})"

# "Build" a Node service = typecheck + OpenAPI export.
build-node-svc service:
    @echo "→ Pre-flighting Node service: {{ service }}"
    cd services/{{ service }} && pnpm install && pnpm run build && pnpm run gen-openapi
    @echo "✓ {{ service }} ready (run as image via: just build-image {{ service }})"

# Build a single service's docker image. Usage:
#   just build-image bot
# just build-image gateway my-registry.io v1.2.3
build-image service registry="local" tag="latest":
    @if [ ! -f "services/{{ service }}/Dockerfile" ]; then \
        echo "✗ services/{{ service }}/Dockerfile not found"; exit 1; fi
    @echo "→ docker build {{ registry }}/{{ service }}:{{ tag }}"
    @if echo "{{ PY_SERVICES }}" | tr ' ' '\n' | grep -qx "{{ service }}"; then \
        docker build -t {{ registry }}/{{ service }}:{{ tag }} -f services/{{ service }}/Dockerfile .; \
    elif echo "{{ NODE_SERVICES }}" | tr ' ' '\n' | grep -qx "{{ service }}"; then \
        docker build -t {{ registry }}/{{ service }}:{{ tag }} -f services/{{ service }}/Dockerfile .; \
    else \
        docker build -t {{ registry }}/{{ service }}:{{ tag }} -f services/{{ service }}/Dockerfile services/{{ service }}; \
    fi
    @echo "✓ {{ registry }}/{{ service }}:{{ tag }}"

# Build images for ALL services (Python + Go).
build-images registry="local" tag="latest":
    @for s in {{ PY_SERVICES }} {{ NODE_SERVICES }} {{ GO_SERVICES }}; do \
        just build-image $s {{ registry }} {{ tag }}; \
    done
    @echo "✓ All backend images built with tag {{ registry }}/<svc>:{{ tag }}"

# ─── quality ────────────────────────────────────────────
fmt:
    uv run ruff check --fix .
    uv run ruff format .
    @for s in {{ GO_SERVICES }}; do cd services/$s && gofmt -w .; cd ../..; done

lint scope="":
    @if [ -z "{{ scope }}" ]; then \
        uv run ruff check . && \
        uv run mypy libs && \
        for s in {{ PY_SERVICES }}; do (cd services/$s && uv run mypy .) || exit 1; done && \
        just lint-node && just lint-go; \
    elif [ -f "services/{{ scope }}/package.json" ]; then \
        cd services/{{ scope }} && pnpm run lint; \
    else \
        cd services/{{ scope }} && uv run ruff check . && uv run mypy .; \
    fi

lint-node:
    @for p in libs/kernel-ts libs/transport-ts; do echo "=== $p ===" && (cd $p && pnpm run typecheck) || exit 1; done
    @for s in {{ NODE_SERVICES }}; do echo "=== $s ===" && (cd services/$s && pnpm run lint) || exit 1; done

lint-go:
    @for s in {{ GO_SERVICES }}; do echo "=== $s ===" && (cd services/$s && go vet ./...); done

# ─── schema ─────────────────────────────────────────────
gen-openapi service:
    @echo "→ Exporting OpenAPI for {{ service }}..."
    @out="{{ service }}-server"; \
    if [ -f "services/{{ service }}/package.json" ]; then \
        cd services/{{ service }} && pnpm exec tsx src/gen-openapi.ts > ../../../../schemas/openapi/$out.json; \
    else \
        cd services/{{ service }} && \
            uv run python src/gen_openapi.py \
            > ../../../../schemas/openapi/$out.json; \
    fi
    @out="{{ service }}-server"; \
    echo "✓ schemas/openapi/$out.json"

gen-openapi-all:
    @for s in {{ PY_SERVICES }} {{ NODE_SERVICES }}; do just gen-openapi $s; done

gen-transport-ts:
    cd libs/transport-ts && pnpm install && pnpm run codegen
    @echo "✓ backend transport-ts clients regenerated"

gen-proto:
    cd ../../schemas && buf generate
    @echo "✓ proto codegen done"

# ─── db ─────────────────────────────────────────────────
migrate-new service version:
    @mkdir -p services/{{ service }}/migrations/versions
    @if ! [[ "{{ version }}" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]]; then \
        echo "✗ version must match v<major>.<minor>.<patch>: {{ version }}"; exit 1; \
    fi
    @file="services/{{ service }}/migrations/versions/{{ version }}.sql" && \
        if [ -e "$file" ]; then echo "✗ migration already exists: $file"; exit 1; fi && \
        printf '%s\n' '-- Write service-owned SQL migration here.' > "$file" && \
        echo "✓ $file"

migrate-up service target_version="":
    @../../scripts/db-migrate.sh services/{{ service }} "{{ target_version }}"
