# Runtime
ENVIRONMENT=development
PORT=8010

# Postgres (shared instance: workflow + knowledge DBs; pgvector image)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=workflow
POSTGRES_PASSWORD=workflow
POSTGRES_DATABASE=knowledge

# Provider lookup; token must match admin and chat.
ADMIN_SERVICE_URL=http://localhost:8001
INTERNAL_API_TOKEN=dev-internal-token

# Object storage and ingestion limits
KNOWLEDGE_DATA_DIR=./data/objects
MAX_OBJECT_BYTES=10485760
ATTACHMENT_MAX_UPLOAD_BYTES=10485760
ATTACHMENT_MARKDOWN_MAX_CHARS=12000
ATTACHMENT_VISION_MAX_TOKENS=1024
INGEST_MAX_PARALLEL=3
LLM_TIMEOUT_SECONDS=60

# RAG / retrieval (see docs/ADR/0019)
EMBEDDING_DIM=1536
CHUNK_MAX_TOKENS=512
CHUNK_OVERLAP_TOKENS=64
CONTEXTUAL_RETRIEVAL_ENABLED=true
RETRIEVAL_CANDIDATE_K=50
RETRIEVAL_TOP_K=8
RRF_K=60
RERANK_ENABLED=true
