# Runtime
ENVIRONMENT=development
PORT=8010

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=dev
MYSQL_PASSWORD=dev
MYSQL_DATABASE=knowledge

# Provider lookup; token must match admin and chat.
ADMIN_SERVICE_URL=http://localhost:8001
INTERNAL_API_TOKEN=dev-internal-token

# Object storage and ingestion limits
KNOWLEDGE_DATA_DIR=./data/objects
MAX_OBJECT_BYTES=10485760
ATTACHMENT_MAX_UPLOAD_BYTES=10485760
ATTACHMENT_MARKDOWN_MAX_CHARS=12000
ATTACHMENT_VISION_MAX_TOKENS=1024
INGEST_MAX_PARALLEL=3
LLM_TIMEOUT_SECONDS=60
