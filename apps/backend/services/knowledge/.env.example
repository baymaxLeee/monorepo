# Runtime
ENVIRONMENT=development
PORT=8010

# Postgres (shared instance: workflow + knowledge DBs; pgvector image)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=knowledge
POSTGRES_PASSWORD=knowledge
POSTGRES_DATABASE=knowledge

# Provider lookup and durable document processing.
ADMIN_SERVICE_URL=http://localhost:8001
EXECUTOR_SERVICE_URL=http://localhost:8011
INTERNAL_API_TOKEN=dev-knowledge-internal-token
ASSET_SERVICE_URL=http://localhost:8013
INTERNAL_SERVICE_TOKENS={"chat":"dev-chat-internal-token","executor":"dev-executor-internal-token"}

# Ingestion and model-facing read limits
MEDIA_MAX_OBJECT_BYTES=536870912
ATTACHMENT_MAX_UPLOAD_BYTES=10485760
ATTACHMENT_MARKDOWN_MAX_CHARS=12000
ATTACHMENT_VISION_MAX_TOKENS=1024
INGEST_MAX_PARALLEL=3
INGEST_MAX_FILES=20
INGEST_MAX_BATCH_BYTES=31457280
EXECUTOR_DISPATCH_INTERVAL_SECONDS=5
EXECUTOR_DISPATCH_MAX_PARALLEL=16
EXECUTOR_REDISPATCH_AFTER_SECONDS=60
ASSET_CLAIM_DISPATCH_INTERVAL_SECONDS=5
LLM_TIMEOUT_SECONDS=60

# RAG / retrieval (see docs/ADR/0019). EMBEDDING_DIM must match both the
# embedding model and the vector() column; 2048 = doubao-embedding-text (Ark).
EMBEDDING_DIM=2048
CHUNK_MAX_TOKENS=512
CHUNK_OVERLAP_TOKENS=64
CONTEXTUAL_RETRIEVAL_ENABLED=true
RETRIEVAL_CANDIDATE_K=50
RETRIEVAL_TOP_K=8
RRF_K=60
RERANK_ENABLED=true
