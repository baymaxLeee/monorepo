# Runtime worker: independent process configuration
ENVIRONMENT=development
PORT=8011
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=runtime
POSTGRES_PASSWORD=runtime
POSTGRES_DATABASE=runtime
WORKFLOW_TARGET_WORLD=@workflow/world-postgres
WORKFLOW_POSTGRES_URL=postgres://workflow:workflow@localhost:5432/workflow
WORKFLOW_POSTGRES_WORKER_CONCURRENCY=20
WORKFLOW_POSTGRES_MAX_POOL_SIZE=24
WORKFLOW_POSTGRES_APPLICATION_MANAGED_SHUTDOWN=1
WORKFLOW_POSTGRES_JOB_LOCK_STALE_SECONDS=30
INTERNAL_API_TOKEN=dev-runtime-internal-token
INTERNAL_SERVICE_TOKENS={"runtime":"dev-runtime-internal-token"}
ADMIN_RPC_TARGET=localhost:9001
STORAGE_RPC_TARGET=localhost:9013
KNOWLEDGE_RPC_TARGET=localhost:9010
