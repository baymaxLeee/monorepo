# Runtime server (worker: .env.worker; sandbox: .env.sandbox)
ENVIRONMENT=development
PORT=8015

# Postgres / Redis
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=runtime
POSTGRES_PASSWORD=runtime
POSTGRES_DATABASE=runtime
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=2

# This workload identity must be present under caller "runtime" at each receiver.
ADMIN_SERVICE_URL=http://localhost:8001
KNOWLEDGE_SERVICE_URL=http://localhost:8010
RUNTIME_WORKER_URL=http://localhost:8011
INTERNAL_API_TOKEN=dev-runtime-internal-token
INTERNAL_SERVICE_TOKENS={"chat":"dev-chat-internal-token"}
STORAGE_SERVICE_URL=http://localhost:8013
RUNTIME_SANDBOX_URL=http://localhost:8014
# HMAC secret for tool-approval replay protection (openssl rand -base64 32).
TOOL_APPROVAL_SECRET=dev-tool-approval-secret

# Agent integrations
EXA_API_KEY=
TAVILY_API_KEY=
PROVIDER_CACHE_TTL_SECONDS=300

CANVAS_SERVICE_URL=http://localhost:8012

# In-memory text editor/save budget; binary Storage uploads keep their own limit.
RUNTIME_EDITABLE_FILE_MAX_BYTES=2097152
