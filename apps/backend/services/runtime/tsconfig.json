{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "declaration": true,
    "lib": ["ES2022"]
  },
  "include": ["src/**/*", "workflows/**/*", "scripts/**/*", "nitro.config.ts"]
}
