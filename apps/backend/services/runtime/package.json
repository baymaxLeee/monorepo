{
  "name": "@backend/runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#runtime/foundation": "./src/infrastructure/foundation/index.ts",
    "#runtime/provider-model": "./src/infrastructure/provider/provider-model.ts",
    "#runtime/provider-url": "./src/infrastructure/provider/provider-url.ts",
    "#runtime/transport": "./src/infrastructure/transport/index.ts"
  },
  "scripts": {
    "dev": "tsx src/cmd/server/main.ts",
    "dev:server": "tsx src/cmd/server/main.ts",
    "dev:sandbox": "tsx src/cmd/sandbox/main.ts",
    "build": "node node_modules/@typescript/native/bin/tsc -p tsconfig.json --noEmit && pnpm build:worker",
    "build:worker": "nitro build",
    "dev:worker": "tsx scripts/build-workflows.ts && tsx src/cmd/worker/main.ts",
    "start:server": "tsx src/cmd/server/main.ts",
    "start:sandbox": "tsx src/cmd/sandbox/main.ts",
    "start:worker": "node --import tsx src/cmd/worker/production.ts",
    "start": "tsx src/cmd/server/main.ts",
    "lint": "pnpm --dir ../../../.. lint:ts apps/backend/services/runtime && pnpm --dir ../../../.. exec oxfmt --check 'apps/backend/services/runtime/**/*.{js,mjs,cjs,jsx,ts,tsx,mts,cts,json,jsonc}' && node node_modules/@typescript/native/bin/tsc -p tsconfig.json --noEmit",
    "gen-openapi": "tsx src/cmd/server/openapi.ts",
    "test": "node --import tsx --test",
    "test:sandbox-integration": "node --import tsx --test sandbox-assets/integration/docker.ts",
    "typecheck": "node node_modules/@typescript/native/bin/tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@ai-sdk/code-mode": "catalog:",
    "@ai-sdk/openai": "catalog:",
    "@ai-sdk/otel": "catalog:",
    "@ai-sdk/provider": "catalog:",
    "@ai-sdk/provider-utils": "catalog:",
    "@ai-sdk/tool-web-fetch": "catalog:",
    "@backend/inner-api": "workspace:*",
    "@hono/node-server": "catalog:",
    "@hono/zod-validator": "catalog:",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.220.0",
    "@opentelemetry/resources": "^2.9.0",
    "@opentelemetry/sdk-trace-base": "^2.9.0",
    "@opentelemetry/sdk-trace-node": "^2.9.0",
    "@repo/agent-runtime": "workspace:*",
    "@workflow/world-postgres": "catalog:",
    "ai": "catalog:",
    "drizzle-orm": "^0.44.0",
    "eventsource-parser": "3.1.0",
    "hono": "catalog:",
    "ioredis": "^5.6.0",
    "openapi-fetch": "^0.17.0",
    "pino": "^9.5.0",
    "postgres": "^3.4.5",
    "tsx": "^4.19.0",
    "workflow": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@typescript/native": "catalog:",
    "@workflow/builders": "catalog:",
    "nitro": "catalog:",
    "rollup": "^4.62.2",
    "typescript": "^5.8.0"
  }
}
