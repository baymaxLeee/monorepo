# Runtime
ENVIRONMENT=development
PORT=8008

# PostgreSQL (service-owned database and login role)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=telemetry
POSTGRES_PASSWORD=telemetry
POSTGRES_DATABASE=telemetry

# Browser telemetry sampling (0-1)
SAMPLE_RATE_PERFORM=1.0
SAMPLE_RATE_EVENT=1.0
