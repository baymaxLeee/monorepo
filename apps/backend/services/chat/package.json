{
  "name": "chat",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "node node_modules/@typescript/native/bin/tsc -p tsconfig.json --noEmit",
    "backfill-workspace-paths": "tsx src/scripts/backfill-workspace-paths.ts",
    "start": "tsx src/index.ts",
    "lint": "pnpm --dir ../../../.. lint:ts apps/backend/services/chat && pnpm --dir ../../../.. exec oxfmt --check 'apps/backend/services/chat/**/*.{js,mjs,cjs,jsx,ts,tsx,mts,cts,json,jsonc}' && node node_modules/@typescript/native/bin/tsc -p tsconfig.json --noEmit",
    "gen-openapi": "tsx src/gen-openapi.ts",
    "test": "node --import tsx --test",
    "typecheck": "node node_modules/@typescript/native/bin/tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@ai-sdk/code-mode": "catalog:",
    "@ai-sdk/provider": "catalog:",
    "@ai-sdk/provider-utils": "catalog:",
    "@ai-sdk/tool-web-fetch": "catalog:",
    "@backend/agent-runtime-ts": "workspace:*",
    "@backend/kernel-ts": "workspace:*",
    "@backend/transport-ts": "workspace:*",
    "@hono/node-server": "catalog:",
    "@hono/zod-validator": "catalog:",
    "ai": "catalog:",
    "drizzle-orm": "^0.44.0",
    "hono": "catalog:",
    "ioredis": "^5.6.0",
    "postgres": "^3.4.5",
    "tsx": "^4.19.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@typescript/native": "catalog:"
  }
}
