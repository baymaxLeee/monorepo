# Runtime
ENVIRONMENT=development
PORT=8009

# MySQL / Redis
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=dev
MYSQL_PASSWORD=dev
MYSQL_DATABASE=chat
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=2

# Internal services; token must match admin, knowledge, and executor.
ADMIN_SERVICE_URL=http://localhost:8001
KNOWLEDGE_SERVICE_URL=http://localhost:8010
EXECUTOR_SERVICE_URL=http://localhost:8011
INTERNAL_API_TOKEN=dev-internal-token

# Agent integrations
TAVILY_API_KEY=
PROVIDER_CACHE_TTL_SECONDS=300
