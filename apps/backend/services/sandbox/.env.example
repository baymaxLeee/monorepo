ENVIRONMENT=development
PORT=8014
INTERNAL_SERVICE_TOKENS={"chat":"dev-chat-internal-token"}
SANDBOX_BACKEND=docker
SANDBOX_IMAGE=local/sandbox-runtime:latest
# Local Docker Desktop uses runc explicitly. Production requires installed runsc.
SANDBOX_RUNTIME=runc
# Started by just up / just up-core / just up-sandbox. Empty disables networking.
SANDBOX_PROXY_URL=http://127.0.0.1:3128
SANDBOX_PROXY_VOLUME=monorepo-sandbox-egress
SANDBOX_NAMESPACE=monorepo-sandboxes
SANDBOX_CPUS=1
SANDBOX_MEMORY_MIB=512
SANDBOX_DISK_MIB=512
SANDBOX_PIDS=128
SANDBOX_TTL_SECONDS=1800
SANDBOX_MAX_TRANSFER_BYTES=104857600
SANDBOX_OUTPUT_BYTES=65536
SANDBOX_COMMAND_TIMEOUT_MS=1800000
SANDBOX_MAX_COMMANDS=64
SANDBOX_MAX_SANDBOXES=16
SANDBOX_MAX_REQUESTS=64
