# Runtime
ENVIRONMENT=development
PORT=8002

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=dev
MYSQL_PASSWORD=dev
IAM_MYSQL_DATABASE=iam

# Access and refresh tokens; JWT secret must match gateway.
ACCESS_TOKEN_SECRET=dev-only-change-me
ACCESS_TOKEN_TTL=5m
REFRESH_TOKEN_TTL=168h
REFRESH_COOKIE_NAME=refresh_token
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax
# REFRESH_COOKIE_DOMAIN=.example.com

# System bootstrap identity and guest organization
SUPER_ADMIN_ID=demo-super-admin
SUPER_ADMIN_ACCOUNT=admin
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=admin123
SUPER_ADMIN_DISPLAY_NAME=Super Admin
GUEST_ORG_ID=guest-org
GUEST_ORG_NAME=游客组织
GUEST_ORG_SLUG=guest-org
