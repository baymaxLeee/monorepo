# Runtime
ENVIRONMENT=development
PORT=8011

# PostgreSQL — business truth (tasks table), isolated from Workflow World below.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=executor
POSTGRES_PASSWORD=executor
POSTGRES_DATABASE=executor

# Outbound workload identity and accepted caller identities.
INTERNAL_API_TOKEN=dev-executor-internal-token
STORAGE_SERVICE_URL=http://localhost:8013
INTERNAL_SERVICE_TOKENS={"canvas":"dev-canvas-internal-token","chat":"dev-chat-internal-token","knowledge":"dev-knowledge-internal-token"}

# ffmpeg binary used by the video-generation workflow to concat scene clips.
# Docker installs it via apt; local dev needs it on PATH (`brew install ffmpeg`).
FFMPEG_PATH=ffmpeg

# Provider calls (SSRF-guarded); knowledge owns the published document.
ADMIN_SERVICE_URL=http://localhost:8001
KNOWLEDGE_SERVICE_URL=http://localhost:8010

# Workflow World (execution/replay truth, not business data). Set by default
# so local dev matches every deployed environment (dev/prod parity — this
# caught a real bug once, see executor/AGENTS.md "Known operational notes"
# #3). `just up` starts the postgres container and runs the
# migration for you. Comment both out to fall back to the filesystem-backed
# Local World if you need to work offline from Docker.
WORKFLOW_TARGET_WORLD=@workflow/world-postgres
WORKFLOW_POSTGRES_URL=postgres://workflow:workflow@localhost:5432/workflow

# Workflow World step concurrency (per process, shared by ALL task types and
# every "use step" — video segments and progress reports). maxPoolSize follows Graphile's
# "queueConcurrency + 2" guidance.
WORKFLOW_POSTGRES_WORKER_CONCURRENCY=20
WORKFLOW_POSTGRES_MAX_POOL_SIZE=24

# Per-workflow-run concurrent video segment generations (default 12, clamped
# 1..12). Segment count is deterministic: target seconds / 12, capped at 12, so
# the default submits every segment in one fan-out batch.
VIDEO_SEGMENT_CONCURRENCY=12

CANVAS_SERVICE_URL=http://localhost:8012
