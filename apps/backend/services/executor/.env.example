# Runtime
ENVIRONMENT=development
PORT=8011

# MySQL — business truth (tasks table). Separate from the Workflow World below.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=dev
MYSQL_PASSWORD=dev
MYSQL_DATABASE=executor

# Internal service auth; token must match every caller (currently chat).
INTERNAL_API_TOKEN=dev-internal-token

# Workflow World (execution/replay truth, not business data). Unset in local
# dev to use the filesystem-backed Local World; every deployed environment
# sets these two to use the self-hosted Postgres World.
# WORKFLOW_TARGET_WORLD=@workflow/world-postgres
# WORKFLOW_POSTGRES_URL=postgres://workflow:workflow@localhost:5432/workflow
