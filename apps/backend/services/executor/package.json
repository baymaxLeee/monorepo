{
  "name": "executor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm build && pnpm start",
    "dev:watch": "nitro dev",
    "build": "nitro build && node scripts/fix-oidc-trace.mjs",
    "start": "node --env-file=.env .output/server/index.mjs",
    "lint": "node node_modules/@typescript/native/bin/tsc -p tsconfig.json --noEmit",
    "typecheck": "node node_modules/@typescript/native/bin/tsc -p tsconfig.json --noEmit",
    "gen-openapi": "tsx src/gen-openapi.ts"
  },
  "dependencies": {
    "@backend/kernel-ts": "workspace:*",
    "@backend/transport-ts": "workspace:*",
    "@hono/zod-validator": "^0.4.0",
    "@workflow/world-postgres": "catalog:",
    "ai": "catalog:",
    "drizzle-orm": "^0.44.0",
    "hono": "^4.7.0",
    "postgres": "^3.4.5",
    "workflow": "catalog:",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@typescript/native": "catalog:",
    "nitro": "3.0.260610-beta",
    "rollup": "^4.62.2",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  }
}
