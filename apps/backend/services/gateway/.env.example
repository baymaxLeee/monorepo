# Runtime
ENVIRONMENT=development
PORT=8000

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=1

# Upstream services
ADMIN_SERVICE_URL=http://localhost:8001
CHAT_SERVICE_URL=http://localhost:8009
IAM_SERVICE_URL=http://localhost:8002
KNOWLEDGE_SERVICE_URL=http://localhost:8010
TELEMETRY_SERVICE_URL=http://localhost:8008

# Edge auth and browser origins; JWT secret must match IAM.
ACCESS_TOKEN_SECRET=dev-only-change-me
ALLOWED_FRONTEND_ORIGINS=http://localhost:3000,http://localhost:3001

# Optional edge overrides (defaults shown).
# MAX_REQUEST_BODY_BYTES=10485760
# HTTP_READ_TIMEOUT=15s
# HTTP_WRITE_TIMEOUT=30s
# HTTP_IDLE_TIMEOUT=120s
# PUBLIC_PATH_PREFIXES=
# Method-aware exact public routes (default: "GET /api/iam-server/orgs" so the
# register page can list applyable orgs before authenticating).
# PUBLIC_EXACT_PATHS=
# OPTIONAL_AUTH_PATH_PREFIXES=
