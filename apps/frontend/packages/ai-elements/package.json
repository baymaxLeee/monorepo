{
  "name": "@repo/ai-elements",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "./src/PromptInput/styles.css"
  ],
  "exports": {
    ".": "./src/AiChat/index.tsx",
    "./prompt-input": "./src/PromptInput/index.tsx",
    "./terminal": "./src/AiChat/terminal.tsx",
    "./code-block": "./src/AiChat/code-block.ts",
    "./conversation": "./src/Conversation/index.ts",
    "./conversation/components/*": "./src/Conversation/components/*.tsx",
    "./conversation/hooks/*": "./src/Conversation/hooks/*.ts",
    "./conversation/lib/*": "./src/Conversation/lib/*.ts",
    "./conversation/store/*": "./src/Conversation/store/*.ts",
    "./components/*": "./src/components/*.tsx"
  },
  "scripts": {
    "lint": "pnpm --dir ../../../.. lint:ts apps/frontend/packages/ai-elements/src && pnpm --dir ../../../.. exec oxfmt --check 'apps/frontend/packages/ai-elements/src/**/*.{js,mjs,cjs,jsx,ts,tsx,mts,cts,json,jsonc}'",
    "format": "pnpm --dir ../../../.. exec oxfmt --write 'apps/frontend/packages/ai-elements/src/**/*.{js,mjs,cjs,jsx,ts,tsx,mts,cts,json,jsonc}'",
    "typecheck": "node node_modules/@typescript/native/bin/tsc --noEmit",
    "test": "pnpm --dir ../.. test --project @repo/ai-elements",
    "ui:add": "shadcn add"
  },
  "dependencies": {
    "@ai-sdk/react": "catalog:",
    "@base-ui/react": "catalog:",
    "@hookform/resolvers": "catalog:",
    "@repo/api": "workspace:*",
    "@repo/design-system": "workspace:*",
    "@repo/editors": "workspace:*",
    "@repo/observability": "workspace:*",
    "@repo/runtime": "workspace:*",
    "@repo/shared": "workspace:*",
    "@streamdown/cjk": "catalog:",
    "@streamdown/code": "catalog:",
    "@streamdown/math": "catalog:",
    "@streamdown/mermaid": "catalog:",
    "@tiptap/core": "catalog:",
    "@tiptap/pm": "catalog:",
    "@tiptap/react": "catalog:",
    "@tiptap/starter-kit": "catalog:",
    "@tiptap/suggestion": "catalog:",
    "ai": "catalog:",
    "lucide-react": "catalog:",
    "react-hook-form": "catalog:",
    "react-router-dom": "catalog:",
    "rehype-harden": "catalog:",
    "streamdown": "catalog:",
    "zod": "catalog:",
    "zustand": "catalog:"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@shadcn/helpers": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@typescript/native": "catalog:",
    "shadcn": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
