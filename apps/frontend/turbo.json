{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^build"]
    }
  },
  "boundaries": {
    "tags": {
      "app": {
        "dependencies": { "allow": ["ui", "data", "runtime", "util"] },
        "dependents": { "allow": [] }
      },
      "ui": {
        "dependencies": { "allow": ["ui", "util"] }
      },
      "data": {
        "dependencies": { "allow": ["runtime", "util"] }
      },
      "runtime": {
        "dependencies": { "allow": ["util"] }
      },
      "util": {
        "dependencies": { "allow": ["util"] }
      }
    }
  }
}
