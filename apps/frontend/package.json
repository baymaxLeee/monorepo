{
  "name": "frontend-workspace",
  "private": true,
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "pnpm --dir ../.. lint:ts apps/frontend && pnpm --dir ../.. exec oxfmt --check 'apps/frontend/**/*.{js,mjs,cjs,jsx,ts,tsx,mts,cts,json,jsonc}'",
    "format": "pnpm --dir ../.. exec oxfmt --write 'apps/frontend/**/*.{js,mjs,cjs,jsx,ts,tsx,mts,cts,json,jsonc}'",
    "typecheck": "turbo run typecheck && node node_modules/@typescript/native/bin/tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@testing-library/react": "catalog:",
    "@types/node": "^24.0.0",
    "@typescript/native": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "jsdom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "catalog:",
    "turbo": "^2.0.0",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": "24.18.0"
  },
  "packageManager": "pnpm@12.5.1"
}
