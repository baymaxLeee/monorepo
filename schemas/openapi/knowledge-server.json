    "/documents/batch-delete": {
      "post": {
        "tags": [
          "documents"
        ],
        "summary": "Batch Delete My Documents",
        "description": "Delete several documents in one transaction.\n\nSame policy as single delete: an workspace_admin may delete any of the workspace's\ndocuments; a member may delete only their own uploads. If ANY requested id\nis outside the workspace or not deletable by the caller, the whole batch is\nrejected with 403 — no silent partial success that would mislead the caller.\nStorage references are released transactionally and RAG `document_chunks` drop via\nthe FK `ON DELETE CASCADE`.",
        "operationId": "batch_delete_my_documents",
        "parameters": [
          {
            "name": "X-Auth-Name",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
