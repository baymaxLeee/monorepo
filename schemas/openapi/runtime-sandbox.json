          }
        }
      }
    },
    "/sessions/{id}/files": {
      "put": {
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-Sandbox-Scope",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "JSON-encoded SandboxScope"
          },
          {
            "name": "path",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-Sandbox-Workspace-Edit",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "mode",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "create",
                "overwrite"
              ]
            }
          },
          {
            "name": "expected_sha256",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/octet-stream": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "saved": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "saved"
                  ]
                }
              }
            }
          }
        }
      },
      "get": {
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-Sandbox-Scope",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "JSON-encoded SandboxScope"
          },
          {
            "name": "path",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "original file bytes",
            "content": {
              "application/octet-stream": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          }
        }
      },
      "delete": {
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-Sandbox-Scope",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "JSON-encoded SandboxScope"
          },
          {
            "name": "path",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "expected_sha256",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "deleted": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "deleted"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/sessions/{id}/snapshot": {
      "post": {
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-Sandbox-Scope",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "JSON-encoded SandboxScope"
          }
        ],
        "responses": {
          "200": {
            "description": "success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SandboxWorkspaceSnapshot"
                }
              }
            }
          }
        }
      }
    },
    "/sessions/{id}/workspace-edits": {
      "post": {
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-Sandbox-Scope",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "JSON-encoded SandboxScope"
          },
          {
            "name": "X-Sandbox-Workspace-Edit",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SandboxWorkspaceEdit"
                }
              }
            }
          }
        }
      },
      "delete": {
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-Sandbox-Scope",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "JSON-encoded SandboxScope"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SandboxWorkspaceEdit"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "released": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "released"
                  ]
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "SandboxScope": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "tenant_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "workspace_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "user_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "conversation_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "run_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "attempt_epoch": {
            "type": "string",
            "maxLength": 20,
            "pattern": "^[1-9][0-9]*$"
          }
        },
        "required": [
          "tenant_id",
          "workspace_id",
          "user_id",
          "conversation_id",
          "run_id",
          "attempt_epoch"
        ],
        "additionalProperties": false
      },
      "SandboxStart": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "scope": {
            "type": "object",
            "properties": {
              "tenant_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "workspace_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "user_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "conversation_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "run_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "attempt_epoch": {
                "type": "string",
                "maxLength": 20,
                "pattern": "^[1-9][0-9]*$"
              }
            },
            "required": [
              "tenant_id",
              "workspace_id",
              "user_id",
              "conversation_id",
              "run_id",
              "attempt_epoch"
            ],
            "additionalProperties": false
          },
          "request_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "sandbox": {
            "type": "object",
            "properties": {
              "attempt": {
                "anyOf": [
                  {
                    "type": "number",
                    "const": 1
                  },
                  {
                    "type": "number",
                    "const": 2
                  }
                ]
              },
              "sandboxed": {
                "type": "boolean"
              },
              "permission_profile": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "const": "managed"
                      },
                      "file_system": {
                        "oneOf": [
                          {
                            "type": "object",
                            "properties": {
                              "type": {
                                "type": "string",
                                "const": "restricted"
                              },
                              "entries": {
                                "maxItems": 64,
                                "type": "array",
                                "items": {
                                  "type": "object",
                                  "properties": {
                                    "path": {
                                      "type": "string",
                                      "minLength": 1,
                                      "maxLength": 4096
                                    },
                                    "access": {
                                      "type": "string",
                                      "enum": [
                                        "read",
                                        "write",
                                        "deny"
                                      ]
                                    }
                                  },
                                  "required": [
                                    "path",
                                    "access"
                                  ],
                                  "additionalProperties": false
                                }
                              }
                            },
                            "required": [
                              "type",
                              "entries"
                            ],
                            "additionalProperties": false
                          },
                          {
                            "type": "object",
                            "properties": {
                              "type": {
                                "type": "string",
                                "const": "unrestricted"
                              }
                            },
                            "required": [
                              "type"
                            ],
                            "additionalProperties": false
                          }
                        ]
                      },
                      "network": {
                        "oneOf": [
                          {
                            "type": "object",
                            "properties": {
                              "type": {
                                "type": "string",
                                "const": "restricted"
                              },
                              "allowed_hosts": {
                                "maxItems": 32,
                                "type": "array",
                                "items": {
                                  "type": "string",
                                  "minLength": 1,
                                  "maxLength": 253
                                }
                              }
                            },
                            "required": [
                              "type",
                              "allowed_hosts"
                            ],
                            "additionalProperties": false
                          },
                          {
                            "type": "object",
                            "properties": {
                              "type": {
                                "type": "string",
                                "const": "enabled"
                              }
                            },
                            "required": [
                              "type"
                            ],
                            "additionalProperties": false
                          }
                        ]
                      }
                    },
                    "required": [
                      "type",
                      "file_system",
                      "network"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "const": "disabled"
                      }
                    },
                    "required": [
                      "type"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "const": "external"
                      },
                      "network": {
                        "oneOf": [
                          {
                            "type": "object",
                            "properties": {
                              "type": {
                                "type": "string",
                                "const": "restricted"
                              },
                              "allowed_hosts": {
                                "maxItems": 32,
                                "type": "array",
                                "items": {
                                  "type": "string",
                                  "minLength": 1,
                                  "maxLength": 253
                                }
                              }
                            },
                            "required": [
                              "type",
                              "allowed_hosts"
                            ],
                            "additionalProperties": false
                          },
                          {
                            "type": "object",
                            "properties": {
                              "type": {
                                "type": "string",
                                "const": "enabled"
                              }
                            },
                            "required": [
                              "type"
                            ],
                            "additionalProperties": false
                          }
                        ]
                      }
                    },
                    "required": [
                      "type",
                      "network"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              "process": {
                "type": "object",
                "properties": {
                  "process_id": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  },
                  "entry_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  }
                },
                "required": [
                  "process_id",
                  "entry_id"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "attempt",
              "sandboxed",
              "permission_profile",
              "process"
            ],
            "additionalProperties": false
          },
          "violation_hint": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "file-system"
                  },
                  "operation": {
                    "type": "string",
                    "enum": [
                      "read",
                      "write"
                    ]
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  }
                },
                "required": [
                  "type",
                  "operation",
                  "path"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "network"
                  },
                  "host": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 253
                  },
                  "port": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 65535
                  },
                  "protocol": {
                    "type": "string",
                    "enum": [
                      "http",
                      "https",
                      "tcp"
                    ]
                  }
                },
                "required": [
                  "type",
                  "host",
                  "port",
                  "protocol"
                ],
                "additionalProperties": false
              }
            ]
          },
          "command": {
            "type": "string",
            "minLength": 1,
            "maxLength": 65536
          },
          "workdir": {
            "default": "/workspace/work",
            "type": "string",
            "maxLength": 1024
          },
          "env": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
            },
            "additionalProperties": {
              "type": "string",
              "maxLength": 4096
            }
          },
          "tty": {
            "default": false,
            "type": "boolean"
          },
          "yield_time_ms": {
            "default": 1000,
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          },
          "timeout_ms": {
            "default": 120000,
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "scope",
          "request_id",
          "sandbox",
          "command"
        ],
        "additionalProperties": false
      },
      "SandboxContinue": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "scope": {
            "type": "object",
            "properties": {
              "tenant_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "workspace_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "user_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "conversation_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "run_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "attempt_epoch": {
                "type": "string",
                "maxLength": 20,
                "pattern": "^[1-9][0-9]*$"
              }
            },
            "required": [
              "tenant_id",
              "workspace_id",
              "user_id",
              "conversation_id",
              "run_id",
              "attempt_epoch"
            ],
            "additionalProperties": false
          },
          "request_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "chars": {
            "default": "",
            "type": "string",
            "maxLength": 65536
          },
          "stdout_offset": {
            "default": 0,
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "stderr_offset": {
            "default": 0,
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "yield_time_ms": {
            "default": 1000,
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          }
        },
        "required": [
          "scope",
          "request_id"
        ],
        "additionalProperties": false
      },
      "SandboxProcess": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "session_id": {
            "type": "string"
          },
          "stdout": {
            "type": "string"
          },
          "stderr": {
            "type": "string"
          },
          "termination": {
            "anyOf": [
              {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "const": "exit"
                      },
                      "exit_code": {
                        "type": "integer",
                        "minimum": -9007199254740991,
                        "maximum": 9007199254740991
                      }
                    },
                    "required": [
                      "type",
                      "exit_code"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "const": "timeout"
                      },
                      "timeout_ms": {
                        "type": "integer",
                        "exclusiveMinimum": 0,
                        "maximum": 9007199254740991
                      }
                    },
                    "required": [
                      "type",
                      "timeout_ms"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
