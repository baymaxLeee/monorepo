{
  "openapi": "3.1.0",
  "info": {
    "title": "Sandbox",
    "version": "1.0.0"
  },
  "paths": {
    "/sessions": {
      "post": {
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SandboxScope"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SandboxSession"
                }
              }
            }
          }
        }
      },
      "delete": {
        "parameters": [
          {
            "name": "X-Sandbox-Scope",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "JSON-encoded SandboxScope"
          }
        ],
        "responses": {
          "200": {
            "description": "success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "destroyed": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "destroyed"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/sessions/{id}/commands": {
      "post": {
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SandboxStart"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SandboxProcess"
                }
              }
            }
          }
        }
      }
    },
    "/sessions/{id}/processes/{processId}": {
      "post": {
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "processId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SandboxContinue"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SandboxProcess"
                }
              }
            }
          }
        }
      },
      "delete": {
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "processId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-Sandbox-Scope",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "JSON-encoded SandboxScope"
          }
        ],
        "responses": {
          "200": {
            "description": "success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SandboxProcess"
                }
              }
            }
          }
        }
      }
    },
    "/sessions/{id}": {
      "delete": {
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-Sandbox-Scope",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "JSON-encoded SandboxScope"
          }
        ],
        "responses": {
          "200": {
            "description": "success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "destroyed": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "destroyed"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/sessions/{id}/files": {
      "put": {
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-Sandbox-Scope",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "JSON-encoded SandboxScope"
          },
          {
            "name": "path",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/octet-stream": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "saved": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "saved"
                  ]
                }
              }
            }
          }
        }
      },
      "get": {
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-Sandbox-Scope",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "JSON-encoded SandboxScope"
          },
          {
            "name": "path",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "original file bytes",
            "content": {
              "application/octet-stream": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "SandboxScope": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "tenant_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "workspace_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "user_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "conversation_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "run_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "required": [
          "tenant_id",
          "workspace_id",
          "user_id",
          "conversation_id",
          "run_id"
        ],
        "additionalProperties": false
      },
      "SandboxStart": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "scope": {
            "type": "object",
            "properties": {
              "tenant_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "workspace_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "user_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "conversation_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "run_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              }
            },
            "required": [
              "tenant_id",
              "workspace_id",
              "user_id",
              "conversation_id",
              "run_id"
            ],
            "additionalProperties": false
          },
          "request_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "command": {
            "type": "string",
            "minLength": 1,
            "maxLength": 65536
          },
          "workdir": {
            "default": "/workspace/work",
            "type": "string",
            "maxLength": 1024
          },
          "env": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
            },
            "additionalProperties": {
              "type": "string",
              "maxLength": 4096
            }
          },
          "tty": {
            "default": false,
            "type": "boolean"
          },
          "yield_time_ms": {
            "default": 1000,
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          },
          "timeout_ms": {
            "default": 120000,
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "scope",
          "request_id",
          "command"
        ],
        "additionalProperties": false
      },
      "SandboxContinue": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "scope": {
            "type": "object",
            "properties": {
              "tenant_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "workspace_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "user_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "conversation_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "run_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              }
            },
            "required": [
              "tenant_id",
              "workspace_id",
              "user_id",
              "conversation_id",
              "run_id"
            ],
            "additionalProperties": false
          },
          "request_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "chars": {
            "default": "",
            "type": "string",
            "maxLength": 65536
          },
          "stdout_offset": {
            "default": 0,
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "stderr_offset": {
            "default": 0,
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "yield_time_ms": {
            "default": 1000,
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          }
        },
        "required": [
          "scope",
          "request_id"
        ],
        "additionalProperties": false
      },
      "SandboxProcess": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "session_id": {
            "type": "string"
          },
          "stdout": {
            "type": "string"
          },
          "stderr": {
            "type": "string"
          },
          "exitCode": {
            "type": [
              "number",
              "null"
            ]
          },
          "stdout_offset": {
            "type": "number"
          },
          "stderr_offset": {
            "type": "number"
          },
          "timed_out": {
            "type": "boolean"
          },
          "truncated": {
            "type": "boolean"
          }
        },
        "required": [
          "session_id",
          "stdout",
          "stderr",
          "exitCode",
          "stdout_offset",
          "stderr_offset",
          "timed_out",
          "truncated"
        ]
      },
      "SandboxSession": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "workdir": {
            "type": "string"
          },
          "expires_at": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "workdir",
          "expires_at"
        ]
      }
    },
    "securitySchemes": {
      "internalToken": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Internal-Token"
      }
    }
  },
  "security": [
    {
      "internalToken": []
    }
  ]
}
