{
  "openapi": "3.1.0",
  "info": {
    "title": "Chat Service",
    "version": "0.1.0",
    "description": "对话 / Agent 微服务 (TypeScript)"
  },
  "paths": {
    "/healthz": {
      "get": {
        "responses": {
          "200": {
            "description": "ok"
          }
        }
      }
    },
    "/conversations": {
      "get": {
        "responses": {
          "200": {
            "description": "list conversations"
          }
        }
      },
      "post": {
        "responses": {
          "201": {
            "description": "create conversation"
          }
        }
      }
    },
    "/conversations/{conversation_id}": {
      "get": {
        "parameters": [
          {
            "name": "conversation_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "conversation detail"
          }
        }
      },
      "patch": {
        "parameters": [
          {
            "name": "conversation_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "update conversation"
          }
        }
      },
      "delete": {
        "parameters": [
          {
            "name": "conversation_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "delete conversation"
          }
        }
      }
    },
    "/conversations/{conversation_id}/agents/run/stream": {
      "post": {
        "parameters": [
          {
            "name": "conversation_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "start WorkflowAgent run stream",
            "headers": {
              "x-workflow-run-id": {
                "description": "Workflow run id used for stream resume/cancel",
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/conversations/{conversation_id}/agents/run/stream/{workflow_run_id}/stream": {
      "get": {
        "parameters": [
          {
            "name": "conversation_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "workflow_run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "startIndex",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "resume WorkflowAgent run stream"
          }
        }
      }
    },
    "/conversations/{conversation_id}/documents/{document_id}": {
      "get": {
        "parameters": [
          {
            "name": "conversation_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "document_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "conversation document detail"
          }
        }
      },
      "patch": {
        "parameters": [
          {
            "name": "conversation_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "document_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "update conversation artifact"
          }
        }
      }
    },
    "/conversations/{conversation_id}/documents/{document_id}/source": {
      "get": {
        "parameters": [
          {
            "name": "conversation_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "document_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "conversation document source bytes"
          }
        }
      }
    },
    "/conversations/{conversation_id}/agents/run/cancel": {
      "post": {
        "parameters": [
          {
            "name": "conversation_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "cancel active agent run"
          }
        }
      }
    },
    "/conversations/{conversation_id}/agents/run/stream/{workflow_run_id}/resume": {
      "post": {
        "parameters": [
          {
            "name": "conversation_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "workflow_run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "resume a suspended ask_user hook"
          }
        }
      }
    },
    "/conversations/{conversation_id}/agents/run/stream/{workflow_run_id}/trace": {
      "get": {
        "parameters": [
          {
            "name": "conversation_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "workflow_run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "agent run step/tool-call trace"
          }
        }
      }
    },
    "/memories": {
      "get": {
        "responses": {
          "200": {
            "description": "list active user memories",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserMemoryList"
                }
              }
            }
          }
        }
      }
    },
    "/memories/candidates": {
      "get": {
        "responses": {
          "200": {
            "description": "list pending memory candidates",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MemoryCandidateList"
                }
              }
            }
          }
        }
      }
    },
    "/memories/candidates/{id}/approve": {
      "post": {
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "approve a memory candidate into active memory",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApprovedMemory"
                }
              }
            }
          }
        }
      }
    },
    "/memories/candidates/{id}/reject": {
      "post": {
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "reject a memory candidate",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RejectedMemory"
                }
              }
            }
          }
        }
      }
    },
    "/memories/candidates/{id}": {
      "patch": {
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateMemoryCandidate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "edit a pending memory candidate before approval",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UpdatedMemoryCandidate"
                }
              }
            }
          }
        }
      }
    },
    "/memories/{id}": {
      "delete": {
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "delete (deactivate) a stored memory",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeletedMemory"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "MemoryCategory": {
        "type": "string",
        "enum": [
          "preference",
          "profile",
          "project",
          "instruction"
        ]
      },
      "UserMemory": {
        "type": "object",
        "required": [
          "id",
          "category",
          "content",
          "confidence"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "category": {
            "$ref": "#/components/schemas/MemoryCategory"
          },
          "content": {
            "type": "string"
          },
          "confidence": {
            "type": "integer"
          }
        }
      },
      "MemoryCandidate": {
        "type": "object",
        "required": [
          "id",
          "category",
          "content",
          "reason",
          "supersedesId",
          "createdAt"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "category": {
            "$ref": "#/components/schemas/MemoryCategory"
          },
          "content": {
            "type": "string"
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "supersedesId": {
            "type": [
              "string",
              "null"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "UserMemoryList": {
        "type": "object",
        "required": [
          "memories"
        ],
        "properties": {
          "memories": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UserMemory"
            }
          }
        }
      },
      "MemoryCandidateList": {
        "type": "object",
        "required": [
          "candidates"
        ],
        "properties": {
          "candidates": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MemoryCandidate"
            }
          }
        }
      },
      "UpdateMemoryCandidate": {
        "type": "object",
        "minProperties": 1,
        "properties": {
          "category": {
            "$ref": "#/components/schemas/MemoryCategory"
          },
          "content": {
            "type": "string",
            "minLength": 5,
            "maxLength": 500
          }
        }
      },
      "ApprovedMemory": {
        "type": "object",
        "required": [
          "memory"
        ],
        "properties": {
          "memory": {
            "$ref": "#/components/schemas/UserMemory"
          }
        }
      },
      "UpdatedMemoryCandidate": {
        "type": "object",
        "required": [
          "candidate"
        ],
        "properties": {
          "candidate": {
            "$ref": "#/components/schemas/MemoryCandidate"
          }
        }
      },
      "RejectedMemory": {
        "type": "object",
        "required": [
          "rejected"
        ],
        "properties": {
          "rejected": {
            "type": "boolean"
          }
        }
      },
      "DeletedMemory": {
        "type": "object",
        "required": [
          "deleted"
        ],
        "properties": {
          "deleted": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
