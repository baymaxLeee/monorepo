{
  "openapi": "3.0.3",
  "info": {
    "title": "Chat Service",
    "version": "0.1.0",
    "description": "对话 / Agent 微服务 (TypeScript)"
  },
  "paths": {
    "/conversations/canvas": {
      "post": {
        "operationId": "createCanvasConversation",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CanvasConversationInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Canvas-bound conversation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CanvasConversationBinding"
                }
              }
            }
          }
        }
      }
    },
    "/healthz": {
      "get": {
        "responses": {
          "200": {
            "description": "ok"
          }
        }
      }
    },
    "/conversations": {
      "get": {
        "responses": {
          "200": {
            "description": "list conversations"
          }
        }
      },
      "post": {
        "responses": {
          "201": {
            "description": "create conversation"
          }
        }
      }
    },
    "/conversations/{conversation_id}": {
      "get": {
        "parameters": [
          {
            "name": "conversation_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "conversation detail"
          }
        }
      },
      "patch": {
        "parameters": [
          {
            "name": "conversation_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "update conversation"
          }
        }
      },
      "delete": {
        "parameters": [
          {
            "name": "conversation_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "delete conversation"
          }
        }
      }
    },
    "/conversations/{conversation_id}/forks": {
      "post": {
        "operationId": "forkConversation",
        "parameters": [
          {
            "name": "conversation_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "message_id"
                ],
                "properties": {
                  "message_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 32
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "History branch with current immutable file snapshots; no tool replay",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "id",
                    "source_conversation_id",
                    "source_message_id"
                  ],
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "source_conversation_id": {
                      "type": "string"
                    },
                    "source_message_id": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Source or checkpoint not found in the caller scope"
          },
          "409": {
            "description": "Active run, processing files, or expired snapshot reservation"
          }
        }
      }
    },
    "/conversations/{conversation_id}/context": {
      "get": {
        "parameters": [
          {
            "name": "conversation_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "conversation context snapshot",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConversationContextResponse"
                }
              }
            }
          }
        }
      }
    },
    "/conversations/{conversation_id}/agents/run/stream": {
      "get": {
        "parameters": [
          {
            "name": "conversation_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "resume the active ToolLoopAgent UI message stream",
            "headers": {
              "x-agent-run-id": {
                "description": "Active agent run id",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "204": {
            "description": "no active stream"
          }
        }
      },
      "post": {
        "parameters": [
          {
            "name": "conversation_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "start ToolLoopAgent UI message stream",
            "headers": {
              "x-agent-run-id": {
                "description": "Agent run id used for observability",
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/conversations/{conversation_id}/documents/{document_id}": {
      "get": {
        "parameters": [
          {
            "name": "conversation_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "document_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "include_content",
            "in": "query",
            "schema": {
              "type": "boolean",
              "default": true
            }
          }
        ],
        "responses": {
          "200": {
            "description": "conversation document detail; include_content=false returns metadata with an empty content_md"
          }
        }
      },
      "patch": {
        "parameters": [
          {
            "name": "conversation_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "document_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "update conversation artifact"
          }
        }
      }
    },
    "/conversations/{conversation_id}/documents/{document_id}/delivery": {
      "post": {
        "parameters": [
          {
            "name": "conversation_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "document_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "max_dim",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4096
            }
          }
        ],
        "responses": {
          "200": {
            "description": "authorized Storage capability",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StorageDelivery"
                }
              }
            }
          },
          "404": {
            "description": "document not accessible"
          }
        }
      }
    },
    "/conversations/{conversation_id}/files/delivery": {
      "post": {
        "parameters": [
          {
            "name": "conversation_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "path",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "authorized Storage capability",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StorageDelivery"
                }
              }
            }
          },
          "404": {
            "description": "file not accessible"
          }
        }
      }
    },
    "/conversations/{conversation_id}/documents/{document_id}/content": {
      "get": {
        "parameters": [
          {
            "name": "conversation_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "document_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "307": {
            "description": "Authorized redirect to Storage",
            "headers": {
              "Location": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "description": "document not accessible"
          }
        }
      }
    },
    "/conversations/{conversation_id}/files/detail": {
      "get": {
        "parameters": [
          {
            "name": "conversation_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "path",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "include_content",
            "in": "query",
            "schema": {
              "type": "boolean",
              "default": true
            }
          }
        ],
        "responses": {
          "200": {
            "description": "conversation virtual file detail",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConversationFile"
                }
              }
            }
          },
          "404": {
            "description": "file not found"
          }
        }
      }
    },
    "/conversations/{conversation_id}/agents/runs/{run_id}/trace": {
      "get": {
        "parameters": [
          {
            "name": "conversation_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "agent run step/tool-call trace",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentRunTrace"
                }
              }
            }
          }
        }
      }
    },
    "/conversations/{conversation_id}/agents/runs/{run_id}/cancel": {
      "post": {
        "parameters": [
          {
            "name": "conversation_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "request agent run cancellation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunCancellation"
                }
              }
            }
          }
        }
      }
    },
    "/conversations/{conversation_id}/video-productions/{production_id}": {
      "get": {
        "parameters": [
          {
            "name": "conversation_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "production_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "durable video production projection",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VideoProductionDetail"
                }
              }
            }
          },
          "403": {
            "description": "approval role required"
          },
          "404": {
            "description": "video production not found"
          }
        }
      }
    },
    "/conversations/{conversation_id}/video-productions/{production_id}/decisions": {
      "post": {
        "parameters": [
          {
            "name": "conversation_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "production_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VideoProductionDecision"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "updated durable video production projection",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VideoProduction"
                }
              }
            }
          },
          "409": {
            "description": "stale production version"
          }
        }
      }
    },
    "/conversations/{conversation_id}/video-productions/{production_id}/preview-url": {
      "get": {
        "parameters": [
          {
            "name": "conversation_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "production_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "staged video preview",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "url",
                    "expires_at"
                  ],
                  "properties": {
                    "url": {
                      "type": "string"
                    },
                    "expires_at": {
                      "type": "string",
                      "format": "date-time"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "preview not available"
          }
        }
      }
    },
    "/conversations/{conversation_id}/video-productions/{production_id}/shots/{shot_id}/takes/{take_id}/preview-url": {
      "get": {
        "parameters": [
          {
            "name": "conversation_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "production_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "shot_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "take_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "staged video take preview",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "url",
                    "expires_at"
                  ],
                  "properties": {
                    "url": {
                      "type": "string"
                    },
                    "expires_at": {
                      "type": "string",
                      "format": "date-time"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "take preview not available"
          }
        }
      }
    },
    "/memories": {
      "get": {
        "responses": {
          "200": {
            "description": "list active user memories",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserMemoryList"
                }
              }
            }
          }
        }
      }
    },
    "/memories/candidates": {
      "get": {
        "responses": {
          "200": {
            "description": "list pending memory candidates",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MemoryCandidateList"
                }
              }
            }
          }
        }
      }
    },
    "/memories/candidates/{id}/approve": {
      "post": {
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "approve a memory candidate into active memory",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApprovedMemory"
                }
              }
            }
          }
        }
      }
    },
    "/memories/candidates/{id}/reject": {
      "post": {
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "reject a memory candidate",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RejectedMemory"
                }
              }
            }
          }
        }
      }
    },
    "/memories/candidates/{id}": {
      "patch": {
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateMemoryCandidate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "edit a pending memory candidate before approval",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UpdatedMemoryCandidate"
                }
              }
            }
          }
        }
      }
    },
    "/memories/{id}": {
      "delete": {
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "delete (deactivate) a stored memory",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeletedMemory"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CanvasConversationInput": {
        "type": "object",
        "required": [
          "project_id",
          "canvas_id"
        ],
        "properties": {
          "project_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 36
          },
          "canvas_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 36
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        }
      },
      "CanvasConversationBinding": {
        "type": "object",
        "required": [
          "id",
          "project_id",
          "canvas_id"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "project_id": {
            "type": "string"
          },
          "canvas_id": {
            "type": "string"
          }
        }
      },
      "RunCancellation": {
        "type": "object",
        "required": [
          "cancelled"
        ],
        "properties": {
          "cancelled": {
            "type": "boolean"
          },
          "status": {
            "type": "string"
          }
        }
      },
      "StorageDelivery": {
        "type": "object",
        "required": [
          "asset_id",
          "revision_id",
          "url",
          "expires_at",
          "filename",
          "media_type",
          "size_bytes"
        ],
        "properties": {
          "asset_id": {
            "type": "string"
          },
          "revision_id": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "filename": {
            "type": "string"
          },
          "media_type": {
            "type": "string"
          },
          "size_bytes": {
            "type": "integer"
          }
        }
      },
      "ConversationFile": {
        "type": "object",
        "required": [
          "path",
          "asset_id",
          "revision_id",
          "title",
          "filename",
          "mime_type",
          "size",
          "sha256",
          "writable",
          "derived",
          "content"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "asset_id": {
            "type": "string"
          },
          "revision_id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "filename": {
            "type": "string"
          },
          "mime_type": {
            "type": "string"
          },
          "size": {
            "type": "integer",
            "nullable": true
          },
          "sha256": {
            "type": "string"
          },
          "writable": {
            "type": "boolean"
          },
          "derived": {
            "type": "boolean"
          },
          "content": {
            "type": "string"
          }
        }
      },
      "AgentRunTrace": {
        "type": "object",
        "required": [
          "runId",
          "status",
          "model",
          "inputTokens",
          "outputTokens",
          "cachedInputTokens",
          "reasoningTokens",
          "totalTokens",
          "contextWindow",
          "steps",
          "toolCalls"
        ],
        "properties": {
          "runId": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "inputTokens": {
            "type": "integer",
            "nullable": true
          },
          "outputTokens": {
            "type": "integer",
            "nullable": true
          },
          "cachedInputTokens": {
            "type": "integer",
            "nullable": true
          },
          "reasoningTokens": {
            "type": "integer",
            "nullable": true
          },
          "totalTokens": {
            "type": "integer",
            "nullable": true
          },
          "contextWindow": {
            "type": "integer",
            "nullable": true
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "stepIndex",
                "kind",
                "status",
                "summary",
                "createdAt",
                "finishedAt",
                "inputTokens",
                "outputTokens",
                "totalTokens",
                "contextSnapshot"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "stepIndex": {
                  "type": "integer"
                },
                "kind": {
                  "type": "string"
                },
                "status": {
                  "type": "string"
                },
                "summary": {
                  "type": "string",
                  "nullable": true
                },
                "createdAt": {
                  "type": "string",
