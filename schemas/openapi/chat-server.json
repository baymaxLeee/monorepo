{
  "openapi": "3.1.0",
  "info": {
    "title": "Chat Service",
    "version": "0.1.0",
    "description": "对话 / Agent 微服务 (TypeScript)"
  },
  "paths": {
    "/healthz": {
      "get": {
        "responses": {
          "200": {
            "description": "ok"
          }
        }
      }
    },
    "/conversations": {
      "get": {
        "responses": {
          "200": {
            "description": "list conversations"
          }
        }
      },
      "post": {
        "responses": {
          "201": {
            "description": "create conversation"
          }
        }
      }
    },
    "/conversations/{conversation_id}": {
      "get": {
        "parameters": [
          {
            "name": "conversation_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "conversation detail"
          }
        }
      },
      "patch": {
        "parameters": [
          {
            "name": "conversation_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "update conversation"
          }
        }
      },
      "delete": {
        "parameters": [
          {
            "name": "conversation_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "delete conversation"
          }
        }
      }
    },
    "/conversations/{conversation_id}/agents/run/stream": {
      "post": {
        "parameters": [
          {
            "name": "conversation_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "start WorkflowAgent run stream",
            "headers": {
              "x-workflow-run-id": {
                "description": "Workflow run id used for stream resume/cancel",
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/conversations/{conversation_id}/agents/run/stream/{workflow_run_id}/stream": {
      "get": {
        "parameters": [
          {
            "name": "conversation_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "workflow_run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "startIndex",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "resume WorkflowAgent run stream"
          }
        }
      }
    },
    "/conversations/{conversation_id}/documents/{document_id}": {
      "get": {
        "parameters": [
          {
            "name": "conversation_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "document_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "conversation document detail"
          }
        }
      },
      "patch": {
        "parameters": [
          {
            "name": "conversation_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "document_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "update conversation artifact"
          }
        }
      }
    },
    "/conversations/{conversation_id}/documents/{document_id}/source": {
      "get": {
        "parameters": [
          {
            "name": "conversation_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "document_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "conversation document source bytes"
          }
        }
      }
    },
    "/conversations/{conversation_id}/agents/run/cancel": {
      "post": {
        "parameters": [
          {
            "name": "conversation_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "cancel active agent run"
          }
        }
      }
    },
    "/conversations/{conversation_id}/agents/run/stream/{workflow_run_id}/resume": {
      "post": {
        "parameters": [
          {
            "name": "conversation_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "workflow_run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "resume a suspended ask_user hook"
          }
        }
      }
    },
    "/conversations/{conversation_id}/agents/run/stream/{workflow_run_id}/trace": {
      "get": {
        "parameters": [
          {
            "name": "conversation_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "workflow_run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "agent run step/tool-call trace"
          }
        }
      }
    }
  }
}
