{
  "name": "monorepo-root",
  "private": true,
  "description": "Meta-monorepo: micro-frontends + microservices",
  "type": "module",
  "scripts": {
    "sync": "just sync",
    "lint:ts": "oxlint -f agent --quiet --report-unused-disable-directives",
    "lint:ui-contracts": "node scripts/check-ui-contracts.mjs",
    "format:ts": "oxfmt --write oxlint.config.ts oxfmt.config.ts package.json 'apps/{frontend,backend}/**/*.{js,mjs,cjs,jsx,ts,tsx,mts,cts,json,jsonc}' 'scripts/**/*.{js,mjs,cjs,jsx,ts,tsx,mts,cts,json,jsonc}'",
    "format:ts:check": "oxfmt --check oxlint.config.ts oxfmt.config.ts package.json 'apps/{frontend,backend}/**/*.{js,mjs,cjs,jsx,ts,tsx,mts,cts,json,jsonc}' 'scripts/**/*.{js,mjs,cjs,jsx,ts,tsx,mts,cts,json,jsonc}'"
  },
  "devDependencies": {
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0",
    "oxlint-tsgolint": "^7.0.2001",
    "turbo": "^2.0.0"
  },
  "engines": {
    "node": "24.18.0"
  },
  "packageManager": "pnpm@12.5.1"
}
