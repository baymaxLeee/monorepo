# A one-shot container that creates each service's Postgres database and applies
# its schema migrations on the shared Postgres instance, then loads prod seed
# rows. Runs once per `docker compose up`; downstream services gate on
# `service_completed_successfully`. Re-deploys skip applied migration versions
# (see postgres-init.sh, which delegates to scripts/db-migrate.sh).
#
# Build context: monorepo root (to COPY across service dirs + scripts).
# Build command in CI:
#   docker buildx build \
#     -f infra/single-vps/Dockerfile.db-init \
#     -t ghcr.io/<owner>/<repo>/db-init:<tag> \
#     .

# bookworm ships bash + psql; db-migrate.sh relies on bash [[ ]] regex + find/awk.
FROM golang:1.26.3-bookworm AS migrator-build
WORKDIR /src
COPY scripts/dbmigrate/go.mod scripts/dbmigrate/go.sum ./
RUN go mod download
COPY scripts/dbmigrate ./
RUN CGO_ENABLED=0 go build -trimpath -o /db-migrate ./cmd/db-migrate

FROM postgres:16-bookworm
COPY --from=migrator-build /db-migrate /usr/local/bin/db-migrate
ENV DB_MIGRATE_BINARY=/usr/local/bin/db-migrate

COPY scripts/db-migrate.sh /db-migrate.sh
COPY infra/single-vps/postgres-init.sh /init.sh
RUN chmod +x /db-migrate.sh /init.sh

# db-migrate.sh expects <service-dir>/migrations/<release>/<release>.<step>.up.sql. Directory names
# MUST match the service → database mapping in postgres-init.sh's SERVICES list.
COPY apps/backend/services/iam/migrations       /schema/iam/migrations
COPY apps/backend/services/admin/migrations     /schema/admin/migrations
COPY apps/backend/services/chat/migrations      /schema/chat/migrations
COPY apps/backend/services/executor/migrations  /schema/executor/migrations
COPY apps/backend/services/knowledge/migrations /schema/knowledge/migrations
COPY apps/backend/services/telemetry/migrations /schema/telemetry/migrations

# Prod-only seed data (env-specific config rows, e.g. the app-registry with
# same-origin MFE manifest URLs). Layout: /seed/<db>/*.sql, applied AFTER schema.
COPY infra/single-vps/seed /seed

ENTRYPOINT ["/init.sh"]

COPY apps/backend/services/canvas/migrations /schema/canvas/migrations
COPY apps/backend/services/asset/migrations  /schema/asset/migrations
