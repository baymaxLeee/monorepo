# Single-VPS deployment configuration.
# Copy to `.env` on the VPS and fill in real values.
#
# Files of this form are intentionally NOT committed; .gitignore covers
# `.env` already.

# Two options the CI mirrors images to (see .github/workflows/build-images.yml):
#
#   1) GHCR (default, free, public images, no `docker login` on VPS)
#      Format: ghcr.io/<owner>/<repo>            (lowercase; GitHub auto-lowercases)
#      Trade-off: pulls cross the Pacific — ~30 minutes for the first 1GB stack
#      on a 3Mbps China-bound link.
#
#   2) Tencent TCR mirror (recommended for China-hosted VPS)
#      Format: ccr.ccs.tencentyun.com/<namespace>
#      Requires: one-time `docker login ccr.ccs.tencentyun.com` on the VPS
#                 (or set up Tencent Cloud's Lighthouse-internal pull credential)
#      Speed:    intra-Tencent-Cloud, MB/s scale, finishes in seconds.
#
# The CI pushes to both when `vars.TCR_NAMESPACE` is configured in the repo;
# just point IMAGE_REGISTRY at whichever you want this VPS to consume.
IMAGE_REGISTRY=ghcr.io/your-github-user/your-repo-name
# IMAGE_REGISTRY=ccr.ccs.tencentyun.com/your-tcr-namespace

# Which image tag to deploy. Match the tag from build-images.yml:
#   :main           → latest commit on main (mutable, easy)
#   :sha-abc12345   → immutable specific commit (recommended for prod)
#   :v1.2.3         → release tag
IMAGE_TAG=main

# The browser hits http://<vps-ip>:PUBLIC_PORT
# Pick 8080 to avoid the China-cloud restriction on 80/443 (those need ICP
# 备案). Pick 80 if you already have ICP record + domain.
PUBLIC_PORT=8080

# PostgreSQL uses one admin login for Workflow World/bootstrap and a dedicated
# least-privilege login for every service database. Generate each value with:
# openssl rand -hex 24
WORKFLOW_POSTGRES_PASSWORD=CHANGE_ME_generate_with_openssl_rand_hex_24
IAM_POSTGRES_PASSWORD=CHANGE_ME_generate_with_openssl_rand_hex_24
ADMIN_POSTGRES_PASSWORD=CHANGE_ME_generate_with_openssl_rand_hex_24
CHAT_POSTGRES_PASSWORD=CHANGE_ME_generate_with_openssl_rand_hex_24
EXECUTOR_POSTGRES_PASSWORD=CHANGE_ME_generate_with_openssl_rand_hex_24
KNOWLEDGE_POSTGRES_PASSWORD=CHANGE_ME_generate_with_openssl_rand_hex_24
TELEMETRY_POSTGRES_PASSWORD=CHANGE_ME_generate_with_openssl_rand_hex_24

# Tavily web search used by chat's web_search tool.
TAVILY_API_KEY=CHANGE_ME_tavily_api_key

# Generate with: openssl rand -hex 32
# Must be the SAME value for gateway and iam; rotating invalidates all
# active sessions.
ACCESS_TOKEN_SECRET=CHANGE_ME_hex_64_chars

# You log in with these on the SPA. Change the password after first login.
SUPER_ADMIN_ACCOUNT=admin
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=CHANGE_ME_admin_password
SUPER_ADMIN_DISPLAY_NAME=Super Admin
GUEST_ORG_ID=guest-org
GUEST_ORG_NAME=游客组织
GUEST_ORG_SLUG=guest-org

# admin owns the LLM provider domain (model / base_url / api_key per user).
# These two secrets gate it.
#
# ADMIN_SECRET_KEY: Fernet key encrypting model_providers.api_key_enc.
#   Generate with either of these (any environment):
#
#     # (a) using openssl only — no Python needed:
#     openssl rand 32 | base64 | tr '+/' '-_' | tr -d '\n' && echo
#
#     # (b) using the in-repo uv environment (already has `cryptography`):
#     cd apps/backend && uv run python -c \
#       "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
#   Both produce a 44-char url-safe-base64 string — Fernet only cares that
#   the *decoded* value is exactly 32 random bytes.
#
#   ⚠️  Rotating this invalidates ALL stored API keys (model_providers
#   rows become un-decryptable). Use per-environment keys; once a value
#   is in prod, do NOT change it without a re-encryption migration.
ADMIN_SECRET_KEY=CHANGE_ME_generate_with_one_of_the_commands_above

INTERNAL_API_TOKEN=CHANGE_ME_random_min_32_chars

# knowledge-server object store upload limit (bytes). Keep in sync with gateway.
MAX_OBJECT_BYTES=10485760
