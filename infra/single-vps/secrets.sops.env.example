# Operator secrets for the single-VPS deploy — the ONLY secrets you hand-manage.
#
# Everything else is automatic (see docs/ADR/0031):
#   - Postgres passwords + INTERNAL_API_TOKEN → generated on the VPS (.env.secrets)
#   - IMAGE_REGISTRY / IMAGE_TAG / PUBLIC_PORT → injected by deploy.sh / CI
#
# This template is plaintext. The REAL file (secrets.sops.env) is SOPS-encrypted
# and committed to git. One-time setup:
#   1. On the VPS: run bootstrap.sh → it prints the VPS age PUBLIC key.
#   2. Put that key in .sops.yaml (repo root).
#   3. Create the encrypted file:
#        cp infra/single-vps/secrets.sops.env.example /tmp/s.env
#        $EDITOR /tmp/s.env              # fill in the CHANGE_ME values
#        sops --encrypt --input-type dotenv --output-type dotenv /tmp/s.env \
#          > infra/single-vps/secrets.sops.env
#        shred -u /tmp/s.env
#   4. git add infra/single-vps/secrets.sops.env && commit  (safe: it's encrypted)
#
# Edit later with:  sops infra/single-vps/secrets.sops.env

# Human login for the SPA. Change the password after first login.
SUPER_ADMIN_ACCOUNT=admin
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=CHANGE_ME_admin_password

# Tavily web search, used by chat's web_search tool.
TAVILY_API_KEY=CHANGE_ME_tavily_api_key

# Gateway<->iam JWT signing key. MUST be identical for both (it is, they share
# this file) and MUST stay stable — rotating invalidates all active sessions.
#   openssl rand -hex 32
ACCESS_TOKEN_SECRET=CHANGE_ME_hex_64_chars

# Fernet key encrypting admin's stored model_providers.api_key_enc.
# MUST stay stable forever once data exists — rotating makes every stored
# provider API key un-decryptable. Generate 32 random bytes url-safe-base64:
#   openssl rand 32 | base64 | tr '+/' '-_' | tr -d '\n' && echo
ADMIN_SECRET_KEY=CHANGE_ME_fernet_key
