<clickhouse>
  <profiles>
    <default>
      <max_memory_usage>1073741824</max_memory_usage>
      <max_threads>2</max_threads>
      <max_concurrent_queries_for_user>4</max_concurrent_queries_for_user>
      <max_bytes_before_external_group_by>268435456</max_bytes_before_external_group_by>
      <max_bytes_before_external_sort>268435456</max_bytes_before_external_sort>
    </default>
  </profiles>
  <users>
    <default>
      <password replace="1" from_env="CLICKHOUSE_PASSWORD" />
      <networks>
        <ip>::/0</ip>
      </networks>
      <profile>default</profile>
      <quota>default</quota>
    </default>
  </users>
</clickhouse>
