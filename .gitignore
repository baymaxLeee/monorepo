# Dependencies
node_modules/
.pnpm-store/
.venv/
__pycache__/
*.egg-info/
*.pyc

# Build artifacts
dist/
build/
.rspack/
.next/
.turbo/
target/

# Module Federation generated remote types (emitted by the dts plugin in
# production builds; never commit — they pollute the source tree if written
# outside dist/)
@mf-types/
*.mf-types.zip

# Test/lint caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
coverage/
*.coverage

# Editor / OS
.DS_Store
.vscode/
.idea/
*.swp
*.log

# Env / secrets
.env
.env.*
!.env.example
# age private keys (single-VPS SOPS: VPS key stays on the VPS, recovery key
# stays offline). The *.sops.env files ARE committed on purpose — encrypted.
age.key
recovery.key
*.agekey

# Worktrees & agent runtime
.worktrees/
.agents/tasks/*/
!.agents/tasks/_template/

# Generated codegen output (regenerated by `just sync`)
apps/frontend/packages/api-client/*/generated/
apps/backend/libs/transport/src/transport/clients/*/generated/
apps/test

# Local docker volumes
pgdata/

# Workflow DevKit Local World (durable run state written to disk in dev)
.workflow-data/
# Nitro build output
.output/
.nitro/

# Go
vendor/
# `just build-go-svc` local dev artifact (Docker builds compile from source
# independently; see apps/backend/services/*/Dockerfile), never commit it.
apps/backend/services/*/bin/

# Knowledge service local object storage (runtime uploads)
apps/backend/services/knowledge/data/
